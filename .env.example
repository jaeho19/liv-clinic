# Site URL
NEXT_PUBLIC_SITE_URL=https://livps.co.kr

# Naver Maps API
# Get your Client ID from https://console.ncloud.com/naver-service/application
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your-naver-map-client-id

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code

# Naver Search Advisor Verification
NEXT_PUBLIC_NAVER_VERIFICATION=your-naver-verification-code

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (Email Service)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Clinic Email (where consultation requests are sent)
CLINIC_EMAIL=info@livps.co.kr

# Instagram API
# Get your access token from Meta for Developers
# See: https://developers.facebook.com/docs/instagram-basic-display-api
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# ========================================
# Slack 라이브채팅 릴레이 (서버 전용)
# ========================================
# 봇 토큰 (xoxb-…). 스코프: chat:write, chat:write.customize, groups:history, groups:write, groups:read, users:read
SLACK_BOT_TOKEN=xoxb-...
# Events API 서명 검증용
SLACK_SIGNING_SECRET=
# #해외문의 채널 ID — 새 문의/완료/재오픈 한 줄 피드 + 방 생성 실패 시 스레드 폴백.
# 이 채널의 사람 멤버가 곧 답변 직원(방 초대 + 멘션 + 담당 대상)이다. 직원 추가/제외는 채널 멤버로만 관리한다.
SLACK_CHANNEL_ID=
# 관찰자 명단 "ID:이름,ID:이름" (원장님 계정 등) — 방에 초대만 되고 멘션·담당 대상이 아니다
SLACK_OBSERVERS=
# 긴급 정지: off 로 두면 방을 만들지 않고 #해외문의 스레드 방식으로만 동작한다. 평소에는 비워 둔다
SLACK_ROOMS=
# 긴급 정지: off 로 두면 손님 방 안의 글을 예전 모양(이름표·색 막대 없이 글자만)으로 올린다. 방 이름 규칙과는 무관. 평소에는 비워 둔다
SLACK_ROOM_LOOK=
# Slack API 호출 타임아웃(ms)
SLACK_POST_TIMEOUT_MS=5000
# 채팅 운영 작업('오늘 연락할 손님' 요약 등) — netlify/functions/chat-ops.mts → POST /api/chat/ops 공유 시크릿. 비우면 503
CHAT_OPS_SECRET=
# 재촉 알림(방의 5·12·30분 "답이 없습니다" + #해외문의 🚨 줄)은 2026-10-02부터 기본이 꺼져 있다. on 으로 두면 다시 켜진다. 평소에는 비워 둔다.
# 다시 켜기 전에 지금 기다리는 대화를 '이미 알린 것'으로 표시할 것 — 안 하면 켜는 순간 밀린 대화마다 알림이 연달아 울린다:
#   UPDATE chat_sessions SET escalation_level = 3 WHERE status = 'open' AND resolved_at IS NULL AND awaiting_since IS NOT NULL;
CHAT_ESCALATION=
# 재촉 알림 임계(분): 담당자 재멘션, 전원, 전원+피드 🚨 — CHAT_ESCALATION=on 일 때만 쓰인다
CHAT_ESCALATION_MINUTES=5,12,30
# 휴진일(한국 날짜, 쉼표 구분). 그날은 하루 종일 상담 시간 외로 본다 — 예: 2026-10-03,2026-10-09. 비우면 휴진일 없음.
# 함수 환경변수는 배포 시점에 고정되므로 값을 바꾼 뒤에는 다시 배포해야 한다
CHAT_CLOSED_DATES=
# 긴급 정지: off 로 두면 '오늘 연락할 손님' 요약과 번역본 게시를 멈춘다(재촉 알림을 켜 둔 경우에는 연락처를 남긴 손님에게도 울린다). 평소에는 비워 둔다
CHAT_FOLLOWUP=
# 긴급 정지: off 로 두면 가격 문의에 이벤트 링크를 자동으로 보내지 않는다. 평소에는 비워 둔다
CHAT_EVENT_HINT=
# Event Subscriptions > Request URL: https://<도메인>/api/slack/events
# Subscribe to bot events: message.groups, group_archive, group_unarchive  (비공개 채널이므로 message.channels가 아님)

# ========================================
# IndexNow (Bing 즉시 색인 통보) — src/lib/indexnow.ts
# ========================================
# 키는 공개값이다. 비우면 코드의 기본 키(public/<key>.txt와 같은 값)를 쓴다. 바꾸면 public/<key>.txt도 같이 바꿀 것
INDEXNOW_KEY=
# 1 이면 전송하지 않는다(장애 시 임시 차단). 개발 환경(NODE_ENV≠production)에서는 원래 보내지 않는다
INDEXNOW_DISABLED=
